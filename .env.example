# =====================================================================
# NEXUS CORE - Configurações do Activity Engine
# =====================================================================

# 1. Integração com GitHub (Opcional, mas recomendado para PRs & Issues)
# Obtenha em: https://github.com/settings/tokens (classic com repo ou fine-grained)
GITHUB_TOKEN=
GITHUB_REPO=rafaelrodrigopa/nexus-core
GITHUB_DEFAULT_BRANCH=main

# 2. Integração com IA (Google Gemini - Opcional)
# O bot gera código de alta qualidade mesmo offline. Se informado, o Gemini
# gerará implementações e documentações sênior dinâmicas a cada commit.
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. Parâmetros da Rotina Diária
MIN_DAILY_COMMITS=5
MAX_DAILY_COMMITS=20

# 4. Modo de Operação (continuous | once | batch)
# continuous: roda como daemon no orquestrador, espalhando os commits pelo dia
RUN_MODE=continuous

# Horário de atividade natural (formato 24h, evita parecer bot de madrugada)
ACTIVE_HOURS_START=7
ACTIVE_HOURS_END=23
